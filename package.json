{
  "name": "arhub",
  "productName": "ArHub",
  "version": "1.0.12",
  "description": "ArHub — AI 科研助手工作台（Electron + FastAPI + 技能工作流）",
  "main": "main.js",
  "author": "jiashuoyan0-maker",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiashuoyan0-maker/ArHub.git"
  },
  "bugs": {
    "url": "https://github.com/jiashuoyan0-maker/ArHub/issues"
  },
  "homepage": "https://github.com/jiashuoyan0-maker/ArHub#readme",
  "keywords": [
    "ai-agent",
    "research",
    "electron",
    "fastapi",
    "openai-compatible",
    "workflow",
    "deepseek",
    "glm"
  ],
  "scripts": {
    "start": "electron .",
    "build:icons": "node scripts/build-icon-subset.cjs",
    "check:js": "node --check main.js && node --check preload.js && node --check updater.js && node --check scripts/build-icon-subset.cjs && node --check dist/assets/arhub-icons.js && node --check dist/assets/arhub-dom-contract.js && node --check dist/assets/arhub-workspace.js && node --check dist/assets/arhub-codex-shell.js && node --check dist/assets/arhub-codex-desktop.js && node --check dist/assets/arhub-editor-studio.js && node --check dist/assets/arhub-studio-shell.js",
    "check:python": "python -B -X utf8 scripts/check-python-syntax.py",
    "test:node": "node scripts/run-node-tests.cjs",
    "test:signing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-signing-trust.ps1",
    "test:python": "python -B -X utf8 -m unittest discover -s tests -v",
    "test": "npm run test:node && npm run test:python && npm run test:signing",
    "test:urls": "python -B -X utf8 -m unittest discover -s tests -v",
    "sync:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-dist-brand.ps1",
    "sync:dist-brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-dist-brand.ps1",
    "audit:open-source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-source-audit.ps1",
    "verify:capabilities": "node scripts/verify-capabilities.cjs",
    "runtime:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/assert-lite-runtime.ps1 -AllowOptionalComponents -EnforceLock",
    "runtime:check:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/assert-runtime.ps1 -EnforceLock",
    "runtime:lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-runtime-lock.ps1",
    "runtime:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-runtime.ps1 -UpdateRepositoryManifest",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -RuntimeProfile lite -UnsignedRelease",
    "package:win:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -RuntimeProfile full -UnsignedRelease",
    "package:win:lite": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -RuntimeProfile lite -UnsignedRelease",
    "package:win:app-only": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -RuntimeProfile app-only -UnsignedRelease",
    "package:win:unsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -AllowUnsigned",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1 -RequireUnsigned",
    "release:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test-installer.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "docx": "9.6.1",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "5.7.3",
    "temml": "0.13.2"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "lucide": "1.28.0"
  }
}
